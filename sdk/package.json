{
  "name": "@otomat/sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for the Otomat x402 micropayment rail on Solana: build payloads, drive the HTTP 402 flow, and add pay-per-call to MCP tools.",
  "license": "MIT",
  "author": "Otomat",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": [
    "solana",
    "x402",
    "payments",
    "micropayments",
    "http-402",
    "mcp",
    "usdc",
    "sdk",
    "agent-payments"
  ],
  "homepage": "https://otomat.fun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otomat-fun/otomat.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/otomat-fun/otomat/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "cross-fetch": "^4.1.0",
    "tweetnacl": "^1.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
