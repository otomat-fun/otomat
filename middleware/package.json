{
  "name": "@otomat/middleware",
  "version": "0.1.1",
  "description": "One line turns any Express, Next.js, or Hono endpoint into a paid x402 API settled in USDC on Solana.",
  "license": "MIT",
  "author": "Otomat",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": [
    "solana",
    "x402",
    "payments",
    "micropayments",
    "http-402",
    "express",
    "nextjs",
    "hono",
    "middleware",
    "usdc"
  ],
  "homepage": "https://otomat.fun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otomat-fun/otomat.git",
    "directory": "middleware"
  },
  "bugs": {
    "url": "https://github.com/otomat-fun/otomat/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@otomat/sdk": "workspace:*",
    "cross-fetch": "^4.1.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0",
    "hono": "^4.0.0",
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "express": "^5.0.0",
    "hono": "^4.6.15",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
